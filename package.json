{
  "name": "agent-watch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run --workspaces test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:hub": "npm --workspace @agent-watch/hub run dev",
    "dev:collector": "npm --workspace @agent-watch/collector run dev",
    "dev:dashboard": "npm --workspace @agent-watch/dashboard run dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
